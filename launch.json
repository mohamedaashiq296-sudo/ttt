{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "request": "launch",
      "name": "Launch Chrome against localhost:3000",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/frontend",
      "userDataDir": "${workspaceFolder}/.vscode/chrome",
      "runtimeArgs": ["--disable-web-security"]
    },

    {
      "type": "chrome",
      "request": "attach",
      "name": "Attach to Chrome (remote debugging)",
      "port": 9222,
      "webRoot": "${workspaceFolder}/frontend"
    },

    {
      "type": "node",
      "request": "launch",
      "name": "Launch Node Backend",
      "program": "${workspaceFolder}/backend/server.js",
      "cwd": "${workspaceFolder}/backend",
      "runtimeExecutable": "node",
      "envFile": "${workspaceFolder}/backend/.env",
      "console": "integratedTerminal",
      "outputCapture": "std"
    },

    {
      "type": "node",
      "request": "attach",
      "name": "Attach to Node (9229)",
      "port": 9229,
      "restart": true,
      "localRoot": "${workspaceFolder}/backend",
      "remoteRoot": null
    }
  ],

  "compounds": [
    {
      "name": "Run Full App (Backend + Chrome)",
      "configurations": ["Launch Node Backend", "Launch Chrome against localhost:3000"]
    }
  ]
}